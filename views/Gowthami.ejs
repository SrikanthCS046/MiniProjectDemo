<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grow Ai | Interview Assistant</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background-color: #0d0d0d;
      color: #fff;
      font-family: 'Inter', sans-serif;
      height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 260px;
      background-color: #121212;
      border-right: 1px solid #1f1f1f;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .sidebar .nav-link {
      color: #b3b3b3;
      font-weight: 500;
      padding: 10px 0;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: color 0.2s ease;
    }

    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      color: #fff;
    }

    .sidebar small {
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-size: 12px;
      margin-top: 25px;
      display: block;
    }

    /* Main content */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background-color: #0d0d0d;
      position: relative;
    }

    .profile-logo {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background-color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }

    .user-name {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 24px;
    }

    .search-bar {
      background-color: #1a1a1a;
      border: none;
      border-radius: 30px;
      padding: 14px 22px;
      width: 480px;
      color: #ddd;
      outline: none;
      font-size: 15px;
      transition: background 0.2s ease;
    }

    .search-bar:focus {
      background-color: #222;
    }

    .action-buttons {
      margin-top: 25px;
      display: flex;
      gap: 15px;
    }

    .action-buttons .btn {
      border-radius: 25px;
      background-color: #1a1a1a;
      color: #ccc;
      padding: 8px 18px;
      border: 1px solid #2b2b2b;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .action-buttons .btn:hover {
      background-color: #2b2b2b;
      color: #fff;
    }

    /* Top right corner (Private lock) */
    .top-right {
      position: absolute;
      top: 20px;
      right: 30px;
      display: flex;
      align-items: center;
      gap: 6px;
      color: #bbb;
      font-size: 14px;
    }

    .top-right i {
      color: #ccc;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .search-bar { width: 90%; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar d-flex flex-column">
    <div>
      <div class="nav flex-column">
        <a href="#" class="nav-link active"><i class="bi bi-search"></i> Search <span class="ms-auto small text-secondary">Ctrl + K</span></a>
        <a href="#" class="nav-link"><i class="bi bi-chat-dots"></i> Interview Chat</a>
        <a href="#" class="nav-link"><i class="bi bi-file-earmark-text"></i> Resume Analysis</a>
        <a href="#" class="nav-link"><i class="bi bi-clock-history"></i> History</a>

        <small>Today</small>
        <a href="#" class="nav-link">Mock Interview Questions</a>
        <a href="#" class="nav-link">Resume Review</a>

        <small>Yesterday</small>
        <a href="#" class="nav-link">Behavioral Questions</a>

        <small>This Week</small>
        <a href="#" class="nav-link">STAR Method Examples</a>
        <a href="#" class="nav-link">Technical Interview Prep</a>

        <small>November</small>
        <a href="#" class="nav-link">Interview Best Practices</a>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <div class="main-content">
    <div class="top-right">
      <i class="bi bi-lock-fill"></i> Private
    </div>

    <div class="profile-logo">
      <i class="bi bi-person"></i>
    </div>
    <h2 class="user-name">Gowthami</h2>

    <input type="text" class="search-bar" placeholder="Ask me anything about interviews...">

    <div class="action-buttons">
      <button class="btn"><i class="bi bi-question-circle"></i> Interview Questions</button>
      <button class="btn"><i class="bi bi-file-earmark-text"></i> Analyze Resume</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


