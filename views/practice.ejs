<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Practice — Grow Ai</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    
    #app-root { min-height: 100vh; }
    
    .sidebar {
      width: 220px;
      border-right: 1px solid #e0e0e0;
      min-height: 100vh;
    }
    .sidebar h4 { font-weight: 600; color: #333; }
    .sidebar a {
      text-decoration: none;
      color: #666;
      padding: 10px 12px;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .sidebar a:hover, .sidebar a.active {
      background: #f0f0f0;
      color: #333;
    }
    
    main { background: #f8f9fa; }
    
    .card {
      border: 1px solid #e0e0e0;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    
    .video-container {
      position: relative;
      background: #000;
      border-radius: 8px;
      overflow: hidden;
    }
    
    #video {
      width: 100%;
      height: auto;
      display: block;
    }
    
    .question-overlay {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      max-width: 600px;
      z-index: 1000;
      display: none;
    }
    
    .question-overlay.show { display: block; }
    
    .progress-bar-custom {
      height: 4px;
      background: #e0e0e0;
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 20px;
    }
    
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      transition: width 0.3s ease;
    }
    
    .metric-badge {
      display: inline-block;
      padding: 6px 12px;
      background: #f0f0f0;
      border-radius: 20px;
      font-size: 13px;
      margin: 4px;
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      font-weight: 600;
    }
    
    .btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }
    
    #liveTranscript {
      max-height: 120px;
      overflow-y: auto;
      padding: 12px;
      background: #f8f9fa;
      border-radius: 8px;
      font-size: 14px;
      line-height: 1.5;
    }
    
    .score-circle {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: 700;
      margin: 0 auto 10px;
    }
  </style>

  <!-- face-api.js -->
  <script defer src="https://unpkg.com/face-api.js@0.22.2/dist/face-api.min.js"></script>
</head>

<body>
  <div class="d-flex" id="app-root">

    <!-- Sidebar -->
    <aside class="sidebar bg-white p-3">
      <h4 class="mb-4">Grow Ai</h4>
      <nav>
        <a href="/home" class="d-block mb-2">🏠 Home</a>
        <a href="/practice" class="d-block mb-2 active">📝 Practice</a>
        <a href="/problem-set" class="d-block mb-2">💻 Coding</a>
        <a href="/dashboard" class="d-block mb-2">📊 Dashboard</a>
        <a href="/profile" class="d-block mt-4">👤 Profile</a>
      </nav>
    </aside>

    <!-- Main -->
    <main class="flex-grow-1 p-4">
      <h2 class="mb-4">Mock Interview Practice</h2>

      <div class="row g-4">

        <!-- Left: Controls -->
        <div class="col-lg-4">
          <div class="card p-4 mb-3">
            <h5 class="mb-3">Interview Setup</h5>
            
            <form id="controlsForm">
              <div class="mb-3">
                <label class="form-label fw-semibold">Interview Type</label>
                <select id="rolePlay" class="form-select">
                  <option>Behavioral</option>
                  <option>Technical</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Interviewer Persona</label>
                <select id="persona" class="form-select">
                  <option>Manager</option>
                  <option>HR</option>
                  <option>Technical Lead</option>
                  <option>Friendly</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Target Role</label>
                <select id="role" class="form-select">
                  <% roles.forEach(role => { %>
                    <option><%= role %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Company</label>
                <select id="company" class="form-select">
                  <% companies.forEach(company => { %>
                    <option><%= company %></option>
                  <% }); %>
                </select>
              </div>

              <div class="alert alert-info small mb-3">
                💡 You'll answer multiple questions. Speak naturally and the AI will provide feedback on your communication skills.
              </div>

              <div class="d-grid gap-2">
                <button type="button" id="startBtn" class="btn btn-primary btn-lg">
                  Start Interview
                </button>
                <button type="button" id="stopBtn" class="btn btn-outline-danger" disabled>
                  End Interview
                </button>
              </div>
            </form>
          </div>

          <!-- Rubric Card -->
          <div class="card p-4">
            <h6 class="fw-semibold mb-3">Evaluation Rubric</h6>
            <ul class="small mb-0">
              <li class="mb-2"><strong>Active Listening:</strong> Answer based on question details</li>
              <li class="mb-2"><strong>STAR Method:</strong> Situation → Task → Action → Result</li>
              <li class="mb-2"><strong>Clarity:</strong> Speak at 110-150 WPM</li>
              <li><strong>Engagement:</strong> Maintain positive expressions</li>
            </ul>
          </div>
        </div>

        <!-- Center/Right: Video & Results -->
        <div class="col-lg-8">
          
          <!-- Current Question Progress -->
          <div id="questionProgress" class="card p-3 mb-3" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0">Question <span id="questionNum">1</span></h6>
              <span class="badge bg-secondary" id="timer">00:00</span>
            </div>
            <div class="progress-bar-custom">
              <div class="progress-fill" id="progressFill" style="width: 0%"></div>
            </div>
            <p id="currentQuestion" class="mb-0 fw-semibold">Your question will appear here...</p>
          </div>

          <!-- Video Feed -->
          <div class="card p-3 mb-3">
            <h6 class="mb-3">Live Camera Feed</h6>
            
            <div class="video-container mb-3">
              <video id="video" autoplay muted playsinline></video>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <div class="metric-badge" id="exprSummary">
                  😊 Expressions: —
                </div>
              </div>
              <div class="col-md-6">
                <div class="metric-badge" id="audioSummary">
                  🎤 Audio: —
                </div>
              </div>
            </div>

            <button id="captureTranscriptBtn" class="btn btn-sm btn-outline-secondary">
              Show Live Transcript
            </button>
            <div id="liveTranscript" class="mt-3" style="display: none;">
              Transcript will appear here as you speak...
            </div>
          </div>

          <!-- Results Section -->
          <div id="resultsArea" class="card p-4" style="display:none;">
            <h4 class="mb-4">Interview Complete! 🎉</h4>

            <div class="row mb-4">
              <div class="col-md-4 text-center">
                <div class="score-circle">
                  <span id="commScore">—</span>
                </div>
                <div class="text-muted">Communication Score</div>
              </div>

              <div class="col-md-8">
                <div class="mb-3">
                  <h6 class="fw-semibold text-success">✅ Strengths</h6>
                  <ul id="strengthsList" class="mb-0"></ul>
                </div>

                <div>
                  <h6 class="fw-semibold text-warning">💡 Areas to Improve</h6>
                  <ul id="suggestionsList" class="mb-0"></ul>
                </div>
              </div>
            </div>

            <hr>
            
            <details>
              <summary class="fw-semibold" style="cursor: pointer;">View Detailed Analytics</summary>
              <pre id="fullJson" class="mt-3 p-3 bg-light rounded small" style="max-height: 300px; overflow: auto;"></pre>
            </details>
          </div>

        </div>
      </div>
    </main>
  </div>

  <!-- Question Modal Overlay -->
  <div class="question-overlay" id="questionOverlay">
    <h5 id="modalQuestion" class="mb-3"></h5>
    <p class="text-muted small mb-3">Take your time to think, then start speaking your answer.</p>
    <button id="closeModalBtn" class="btn btn-primary w-100">Got it, let me answer</button>
  </div>

  <script src="/js/practice-client.js"></script>
</body>
</html>
