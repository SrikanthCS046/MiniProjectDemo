<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Grow Ai — Profile</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root{
      --bg:#f6f9fb;
      --card:#ffffff;
      --muted:#6b7280;
      --accent-start:#5B67E2;
      --accent-end:#2BB0A3;
      --positive:#16B364;
    }
    body{ background:var(--bg); font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial; color:#0f1724; }

    .container-xl { max-width:1200px; }

    /* Layout */
    .profile-wrap { margin:40px auto; display:grid; grid-template-columns: 220px 1fr 320px; gap:24px; align-items:start; }

    /* Left nav */
    .side-nav { background:var(--card); border-radius:12px; padding:20px; box-shadow:0 10px 30px rgba(12,18,28,0.06); height:fit-content; }
    .side-nav .nav-link { display:flex; align-items:center; gap:12px; padding:12px; border-radius:10px; color:var(--muted); }
    .side-nav .nav-link.active { background: linear-gradient(90deg, rgba(91,103,226,0.10), rgba(43,176,170,0.06)); color:#0f1724; font-weight:600; }

    /* Center card */
    .main-card { background:var(--card); border-radius:12px; padding:0; overflow:hidden; box-shadow:0 18px 48px rgba(12,18,28,0.06); }
    .cover {
      height:120px;
      background: linear-gradient(90deg, var(--accent-start), var(--accent-end));
      position:relative;
    }
    .avatar {
      width:120px;height:120px;border-radius:50%; border:6px solid var(--card);
      position: absolute; left:28px; bottom:-60px; background:#fff; overflow:hidden;
      box-shadow: 0 10px 30px rgba(12,18,28,0.12);
    }
    .avatar img{ width:100%; height:100%; object-fit:cover; display:block; }

    .main-body { padding:84px 28px 28px 28px; }

    .headline { display:flex; gap:16px; align-items:center; justify-content:space-between; }
    .headline .title { font-weight:700; font-size:28px; }
    .subtitle { color:var(--muted); margin-top:4px; font-size:14px; }

    .btn-edit { background: linear-gradient(90deg,var(--accent-start),var(--accent-end)); color:white; border: none; border-radius:10px; padding:10px 14px; box-shadow:0 10px 36px rgba(91,103,226,0.12); }

    /* Metrics row */
    .metrics { margin-top:18px; display:grid; grid-template-columns: repeat(4,1fr); gap:12px; }
    .metric { background:#fbfdff; border-radius:10px; padding:12px; text-align:center; box-shadow: 0 8px 20px rgba(12,18,28,0.04); }
    .metric .num { font-size:22px; font-weight:700; }
    .metric small { color:var(--muted); display:block; margin-top:6px; }

    /* Resume card & badges */
    .resume-card { margin-top:18px; display:flex; gap:16px; align-items:center; padding:12px; border-radius:10px; background:linear-gradient(180deg,#ffffff,#fbfdff); border:1px solid rgba(12,18,28,0.03); }
    .resume-icon { width:80px;height:80px;border-radius:8px;background:linear-gradient(180deg,#eef6ff,#fff); display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent-start); }

    .badges { display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }
    .badge-custom { background:linear-gradient(90deg, rgba(91,103,226,0.12), rgba(43,176,170,0.06)); padding:8px 12px; border-radius:999px; font-weight:600; color:#0f1724; }

    /* Activity feed */
    .activity { margin-top:20px; }
    .activity .item { display:flex; gap:12px; align-items:center; padding:12px; border-radius:10px; background:#fff; border:1px solid rgba(12,18,28,0.03); margin-bottom:10px; }
    .activity .score { width:56px;height:56px;border-radius:8px; background:linear-gradient(180deg,#f1fbf6,#fff); display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--positive); }

    /* Right panel */
    .right-card { background:var(--card); border-radius:12px; padding:16px; box-shadow:0 10px 26px rgba(12,18,28,0.06); position:sticky; top:24px; height:fit-content; }
    .right-card h6 { margin-bottom:12px; }
    .insight { font-size:14px; color:var(--muted); margin-bottom:8px; }

    .start-btn { width:100%; padding:10px; border-radius:10px; background: linear-gradient(90deg,var(--accent-start),var(--accent-end)); color:#fff; border:none; font-weight:700; }

    /* responsive */
    @media (max-width: 1100px){
      .profile-wrap { grid-template-columns: 1fr; padding:0 12px; }
      .avatar { left:20px; bottom:-60px; transform: translateY(0); }
      .right-card{ position:static; top:auto; margin-top:16px; }
    }
  </style>
</head>
<body>

  <div class="container-xl profile-wrap">
    <!-- LEFT NAV -->
    <aside class="side-nav">
      <div class="mb-3 fw-bold">Profile</div>
      <nav class="nav flex-column">
        <a class="nav-link active" href="#"><i class="bi bi-person-fill"></i> Overview</a>
        <a class="nav-link" href="#"><i class="bi bi-play-btn-fill"></i> Sessions</a>
        <a class="nav-link" href="#"><i class="bi bi-bar-chart-fill"></i> Progress</a>
        <a class="nav-link" href="#"><i class="bi bi-file-earmark-text"></i> Resume</a>
        <a class="nav-link" href="#"><i class="bi bi-gear-fill"></i> Settings</a>
      </nav>
    </aside>

    <!-- CENTER MAIN CARD -->
    <section class="main-card">
      <div class="cover">
        <!-- avatar overlapping -->
        <div class="avatar">
          <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ4cQ6bwqeTPcTA_F8T_uU9b3iLJtRPTXecpw&s" alt="avatar">
        </div>
      </div>

      <div class="main-body">
        <div class="headline">
          <div>
            <div class="title">Nobita Nobi</div>
            <div class="subtitle">Prvithi ka rakhvala • Interview confidence: <strong style="color:var(--accent-start)">87%</strong></div>
          </div>
          <div class="text-end">
            <button class="btn-edit">Edit Profile</button>
            <div style="font-size:13px;color:var(--muted);margin-top:8px">Loyal from 3-01-2003</div>
          </div>
        </div>

        <div class="metrics">
          <div class="metric">
            <div class="num">87%</div>
            <small>Overall Score</small>
          </div>
          <div class="metric">
            <div class="num">+12%</div>
            <small>Clarity (last 30d)</small>
          </div>
          <div class="metric">
            <div class="num">18</div>
            <small>Interviews Completed</small>
          </div>
          <div class="metric">
            <div class="num">5d</div>
            <small>Streak</small>
          </div>
        </div>

        <div class="resume-card mt-3">
          <div class="resume-icon"><i class="bi bi-file-earmark-text" style="font-size:28px"></i></div>
          <div style="flex:1">
            <div style="font-weight:700">Resume • last analyzed 3 days ago</div>
            <div style="color:var(--muted);margin-top:6px">ATS score: <span style="font-weight:700;color:#0f1724">78%</span> • Tailor for Senior Frontend</div>
            <div style="margin-top:8px">
              <button class="btn btn-outline-secondary btn-sm me-2">Download report</button>
              <button class="btn btn-primary btn-sm" style="background:linear-gradient(90deg,var(--accent-start),var(--accent-end));border:none">Re-analyze Resume</button>
            </div>
          </div>
        </div>

        <div class="badges">
          <div class="badge-custom">STAR Master</div>
          <div class="badge-custom">Answer Clarity</div>
          <div class="badge-custom">Algo Novice</div>
        </div>

        <div class="activity">
          <h6 style="margin-top:18px">Recent activity</h6>
          <div class="item d-flex align-items-center">
            <div class="score">92</div>
            <div style="flex:1">
              <div style="font-weight:700">Company-specific mock — Google SRE</div>
              <div style="color:var(--muted);font-size:13px;margin-top:6px">3 days ago • 45 min • Tags: System Design, Scalability</div>
            </div>
            <div><button class="btn btn-sm btn-outline-primary">View</button></div>
          </div>

          <div class="item d-flex align-items-center">
            <div class="score">80</div>
            <div style="flex:1">
              <div style="font-weight:700">Behavioral mock — Leadership</div>
              <div style="color:var(--muted);font-size:13px;margin-top:6px">1 week ago • 20 min • Tags: STAR</div>
            </div>
            <div><button class="btn btn-sm btn-outline-primary">View</button></div>
          </div>
        </div>

      </div>
    </section>

    <!-- RIGHT PANEL -->
    <aside class="right-card">
      <h6>Quick actions</h6>
      <p class="insight">Start a mock interview, request a mentor review, or share your profile with recruiters.</p>
      <div class="d-grid gap-2 mb-3">
        <button class="start-btn"><i class="bi bi-play-fill me-2"></i> Start Mock Interview</button>
        <button class="btn btn-outline-secondary">Request Mentor Review</button>
      </div>

      <div style="margin-top:16px">
        <h6 class="mb-2">AI insights</h6>
        <div class="insight">• Speaking clarity improved by 12% compared to last month.</div>
        <div class="insight">• Reduce filler words; try 1-second pauses.</div>
        <a href="#" class="small text-decoration-none" style="color:var(--accent-start)">View detailed analysis →</a>
      </div>

      <div style="margin-top:18px">
        <h6 class="mb-2">Weekly trend</h6>
        <img src="https://dummyimage.com/300x90/eff6ff/94a3b8.png&text=Sparkline" alt="sparkline" style="width:100%;border-radius:8px">
      </div>
    </aside>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
