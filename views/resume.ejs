<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Analyzer - Grow AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #6366f1;
            --secondary-color: #8b5cf6;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --warning-color: #f59e0b;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-500: #6b7280;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
            --white: #ffffff;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, var(--gray-50) 0%, #e0e7ff 100%);
            min-height: 100vh;
            line-height: 1.6;
            color: var(--gray-700);
        }

        .main-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        .header-section {
            text-align: center;
            margin-bottom: 3rem;
        }

        .header-section h1 {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .header-section p {
            font-size: 1.1rem;
            color: var(--gray-500);
            max-width: 600px;
            margin: 0 auto;
        }

        .upload-section {
            background: var(--white);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            margin-bottom: 2rem;
            border: 1px solid var(--gray-100);
            transition: box-shadow 0.3s ease;
        }

        .upload-section:hover {
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .upload-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 768px) {
            .upload-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }

        .file-upload {
            border: 2px dashed var(--gray-200);
            border-radius: 12px;
            padding: 2rem 1rem;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            background: var(--gray-50);
        }

        .file-upload:hover {
            border-color: var(--primary-color);
            background: #f0f4ff;
        }

        .file-upload input[type="file"] {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .file-upload i {
            font-size: 2.5rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
            display: block;
        }

        .file-upload h5 {
            font-weight: 600;
            color: var(--gray-700);
            margin-bottom: 0.5rem;
        }

        .file-upload p {
            color: var(--gray-500);
            font-size: 0.9rem;
        }

        .jd-input {
            border: 2px dashed var(--gray-200);
            border-radius: 12px;
            padding: 1.5rem;
            resize: vertical;
            font-family: inherit;
            background: var(--gray-50);
            transition: border-color 0.3s ease;
            min-height: 120px;
        }

        .jd-input:focus {
            border-color: var(--primary-color);
            background: var(--white);
            outline: none;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .analyze-btn {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            color: var(--white);
            padding: 1rem 2.5rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
            width: 100%;
        }

        .analyze-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        }

        .result-card {
            background: var(--white);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            margin-bottom: 2rem;
            border: 1px solid var(--gray-100);
        }

        .score-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            position: relative;
            margin: 0 auto 1rem;
        }

        .score-circle .outer {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .score-circle .inner {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--success-color);
        }

        .skill-gap-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 1.5rem;
        }

        .skill-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray-100);
        }

        .skill-item:last-child {
            border-bottom: none;
        }

        .skill-icon {
            font-size: 1.2rem;
            margin-right: 0.75rem;
            width: 20px;
        }

        .skill-present .skill-icon { color: var(--success-color); }
        .skill-missing .skill-icon { color: var(--danger-color); }

        .skill-name {
            font-weight: 500;
            color: var(--gray-700);
        }

        .skill-missing .skill-name {
            color: var(--danger-color);
        }

        .suggestions-section h5 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--gray-800);
            margin-bottom: 1.5rem;
        }

        .suggestions-list {
            list-style: none;
            padding: 0;
        }

        .suggestions-list li {
            padding: 1rem;
            margin-bottom: 0.75rem;
            background: var(--gray-50);
            border-radius: 8px;
            border-left: 4px solid var(--primary-color);
            padding-left: 1.25rem;
            color: var(--gray-600);
            transition: background 0.3s ease;
        }

        .suggestions-list li:hover {
            background: var(--gray-100);
        }

        .error-alert {
            background: linear-gradient(135deg, #fef2f2, #fecaca);
            border: none;
            color: var(--danger-color);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 2rem;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 2rem;
        }

        .spinner {
            border: 3px solid var(--gray-200);
            border-top: 3px solid var(--primary-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 1rem;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="header-section">
            <h1><i class="fas fa-file-alt me-2"></i>Smart Resume Analyzer</h1>
            <p>Upload your resume and optional job description to get instant ATS compatibility scores and personalized improvement tips.</p>
        </div>

        <form action="/resume-analysis" method="POST" enctype="multipart/form-data" id="uploadForm">
            <div class="upload-section">
                <div class="upload-grid">
                    <div>
                        <label for="resume" class="file-upload">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <h5>Upload Resume</h5>
                            <p>PDF, DOCX, or Image (JPG/PNG) • Max 5MB</p>
                            <input type="file" id="resume" name="resume" accept=".pdf,.docx,.doc,.jpg,.jpeg,.png,.tiff" required>
                        </label>
                    </div>
                    <div>
                        <label class="file-upload mb-2" for="jd">
                            <i class="fas fa-paste"></i>
                            <h5>Job Description</h5>
                            <p>Optional • Paste the full job posting here</p>
                        </label>
                        <textarea 
                            class="jd-input" 
                            id="jd" 
                            name="jd" 
                            placeholder="Paste the job description text here to get tailored skill matching..."
                        ></textarea>
                    </div>
                </div>
                <button type="submit" class="analyze-btn">
                    <i class="fas fa-magic me-2"></i>Analyze My Resume
                </button>
            </div>
        </form>

        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p>Analyzing your resume... This may take a moment.</p>
        </div>

        <% if (error) { %>
            <div class="alert error-alert">
                <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
            </div>
        <% } %>

        <% if (atsScore !== null && resumeSkills !== null) { %>
            <div class="result-card">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center">
                        <div class="score-circle">
                            <div class="outer" style="background: conic-gradient(var(--success-color) 0deg, var(--success-color) <%= (atsScore * 3.6) %>deg, var(--gray-200) <%= (atsScore * 3.6) %>deg 360deg);">
                                <div class="inner"><%= atsScore %>%</div>
                            </div>
                        </div>
                        <h6 class="text-muted mb-0">ATS Score</h6>
                        <small class="text-success fw-bold">Great Match!</small>
                    </div>
                    <div class="col-md-9">
                        <h4 class="skill-gap-title mb-4">Skill Gap Analysis</h4>
                        <div class="row">
                            <div class="col-6">
                                <h6 class="text-success mb-2"><i class="fas fa-check-circle me-1"></i>Present in Resume</h6>
                                <% if (resumeSkills && resumeSkills.length > 0) { %>
                                    <% resumeSkills.slice(0, 5).forEach(skill => { %>
                                        <div class="skill-item skill-present">
                                            <i class="fas fa-check skill-icon"></i>
                                            <span class="skill-name"><%= skill.charAt(0).toUpperCase() + skill.slice(1) %></span>
                                        </div>
                                    <% }) %>
                                    <% if (resumeSkills.length > 5) { %>
                                        <small class="text-muted">+<%= resumeSkills.length - 5 %> more</small>
                                    <% } %>
                                <% } else { %>
                                    <p class="text-muted">No skills detected.</p>
                                <% } %>
                            </div>
                            <div class="col-6">
                                <h6 class="text-danger mb-2"><i class="fas fa-times-circle me-1"></i>Missing from JD</h6>
                                <% if (missingSkills && missingSkills.length > 0) { %>
                                    <% missingSkills.forEach(skill => { %>
                                        <div class="skill-item skill-missing">
                                            <i class="fas fa-times skill-icon"></i>
                                            <span class="skill-name"><%= skill.charAt(0).toUpperCase() + skill.slice(1) %></span>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-success">All matched!</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (suggestions && suggestions.length > 0) { %>
                <div class="result-card">
                    <div class="suggestions-section">
                        <h5><i class="fas fa-lightbulb me-2" style="color: var(--warning-color);"></i>Actionable Improvement Steps</h5>
                        <ul class="suggestions-list">
                            <% suggestions.forEach(suggestion => { %>
                                <li><%= suggestion %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('uploadForm').addEventListener('submit', function() {
            document.getElementById('loading').style.display = 'block';
            document.querySelector('.analyze-btn').style.display = 'none';
        });

        // File drag & drop enhancement (optional polish)
        const fileUpload = document.querySelector('.file-upload input[type="file"]');
        const uploadLabel = fileUpload.closest('.file-upload');

        uploadLabel.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadLabel.style.borderColor = 'var(--primary-color)';
        });

        uploadLabel.addEventListener('dragleave', () => {
            uploadLabel.style.borderColor = 'var(--gray-200)';
        });

        uploadLabel.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadLabel.style.borderColor = 'var(--gray-200)';
            fileUpload.files = e.dataTransfer.files;
        });
    </script>
</body>
</html>

